# --- Tietokanta ---
# pglite = paikallinen kehityskanta (.data/pglite), postgres = Supabase.
# Oletus: kehityksessä pglite, Vercelissä postgres (src/lib/config/deploy-env.ts).
DB_DRIVER=pglite
# Supabase: Connect → Direct → Transaction pooler, "Use IPv4 connection" päällä.
# Muoto: postgresql://postgres.<projekti>:<salasana>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Kirjautuminen ---
# dev = kehityskirjautuminen (käyttäjän valinta listasta, EI tuotantoon), auth0 = Auth0 (BLOCKERS 6)
AUTH_MODE=dev
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 satunnaista tavua hex-muodossa
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# --- Evästeiden allekirjoitus ja kenttäsalaus (32 satunnaista tavua base64) ---
# Tuotannossa pakollisia. Kehityksessä käytetään kiinteää avainta.
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=

# --- Tekstiviestit (BLOCKERS 2) ---
# mock = viestit kirjataan lokiin eivätkä lähde. Todellinen palvelu lisätään src/lib/sms/index.ts:ään.
SMS_MODE=mock

# Fennoa: mock (oletus, ei yhteyttä) tai test (Fennoan testiyritys). Tuotantoa ei ole otettu käyttöön.
FENNOA_MODE=mock
# FENNOA_TEST_API_USER=
# FENNOA_TEST_API_KEY=

# Sähköposti (tiedotteet): mock (oletus, ei lähetä) tai resend. Lähettäjän verkkotunnus vahvistettava Resendissä.
EMAIL_MODE=mock
# RESEND_API_KEY=
# EMAIL_FROM=tiedotteet@example.fi

# Kirjeet: mock (oletus, ei lähetä) tai postita (Postita.fi, samat tunnukset kuin verkkopalvelussa).
LETTER_MODE=mock
# POSTITA_USERNAME=
# POSTITA_PASSWORD=
# Palveluntarjoajan saapuvien viestien reitti /api/sms/inbound: Authorization: Bearer <salaisuus>. Ilman arvoa reitti ei ole käytössä.
SMS_WEBHOOK_SECRET=
